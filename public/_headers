# Cloudflare Pages 响应头。改完要重新部署才生效。

# Service Worker 必须每次都回源校验。浏览器注册时默认 updateViaCache: 'imports'，
# 主脚本本来就不吃 HTTP 缓存，但边缘节点若缓存了旧 sw.js，回源拿到的仍是旧的。
/sw.js
  Cache-Control: no-cache

# 清单用标准 MIME；万一托管方认不出 .webmanifest，浏览器会直接拒绝解析，静默装不上
/manifest.webmanifest
  Content-Type: application/manifest+json

# 图标极少变动
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-maskable-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
